# Port the HTTP server listens on.
PORT=8080

# Node environment. `development` relaxes the boot guards below.
NODE_ENV=development

# ── Inbound auth ─────────────────────────────────────────────────────────
# Shared bearer token: every /ops/*, /connections* request must send
#   Authorization: Bearer <TELEGRAM_TOOL_TOKEN>
# hadron-server holds the same value as TELEGRAM_TOOL_TOKEN.
# Required in production — the service refuses to start without it.
TELEGRAM_TOOL_TOKEN=

# ── Database ─────────────────────────────────────────────────────────────
# The tool's OWN database (never core's). Holds encrypted bot tokens, the
# getUpdates poll cursors, and idempotency records.
DATABASE_URL=postgresql://holger@localhost:5432/hadrontool_telegram

# ── Secrets ──────────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of bot tokens at rest.
# Distinct from core's HADRON_ENCRYPTION_KEY by design. Required in production.
TOKEN_ENCRYPTION_KEY=

# ── Event plane (tool → core) ────────────────────────────────────────────
# Where normalized Telegram events are POSTed (hadron-server's internal
# ingress, /internal/telegram-events) and the bearer that call carries.
# Unset ⇒ events are logged + dropped AND the poll cursor still advances —
# an unconfigured consumer is deliberate, not an outage.
CORE_EVENTS_URL=
CORE_EVENTS_TOKEN=

# ── Polling ──────────────────────────────────────────────────────────────
# getUpdates long-poll timeout in seconds (Telegram holds the request open).
TELEGRAM_POLL_TIMEOUT_S=30
# Set to `true` to disable the poll worker (ops plane still serves).
DISABLE_POLL_WORKER=

# ── Sending ──────────────────────────────────────────────────────────────
# Minimum gap between sends to the SAME chat, in ms (~1 msg/s per Telegram's
# guidance). The pacer never holds a request longer than 5s — beyond that it
# returns provider_rate_limited and core's sweep worker retries durably.
TELEGRAM_SEND_GAP_MS=1000

# Override the Bot API origin (tests / self-hosted Bot API servers).
TELEGRAM_API_BASE=https://api.telegram.org

# Max request body size accepted by the JSON parser.
MAX_BODY_SIZE=1mb
